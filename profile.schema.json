{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wesseltl/pdf-mcp/main/profile.schema.json",
  "title": "pdf-mcp extraction profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_schema_version", "id", "version", "description", "table"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "profile_schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "header_search_rows": {"type": "integer", "minimum": 1, "maximum": 20, "default": 3},
        "minimum_header_match": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 1},
        "allow_extra_columns": {"type": "boolean", "default": true},
        "min_records": {"type": "integer", "minimum": 1, "default": 1},
        "unique_by": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true,
          "default": []
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
              "aliases": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true,
                "default": []
              },
              "type": {
                "enum": ["string", "integer", "decimal", "boolean", "date"],
                "default": "string"
              },
              "required": {"type": "boolean", "default": false},
              "allow_blank": {"type": "boolean"},
              "pattern": {"type": "string", "minLength": 1},
              "enum": {"type": "array", "minItems": 1},
              "minimum": {"type": ["number", "string"]},
              "maximum": {"type": ["number", "string"]},
              "formats": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "minItems": 1
              }
            }
          }
        }
      }
    }
  }
}
