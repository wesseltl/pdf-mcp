[Unit]
Description=Smart Lab Index controlled-production service
After=local-fs.target
ConditionPathIsDirectory=/srv/lab-data
ConditionPathExists=/etc/smart-lab-index/operator.token

[Service]
Type=simple
User=smart-lab-index
Group=smart-lab-index
EnvironmentFile=/etc/smart-lab-index/smart-lab-index.env
WorkingDirectory=/var/lib/smart-lab-index
LoadCredential=operator.token:/etc/smart-lab-index/operator.token
ExecStart=/opt/smart-lab-index/venv/bin/smart-lab-index-app ${SMART_LAB_SOURCE_ROOT} --database ${SMART_LAB_DATABASE} --source-id ${SMART_LAB_SOURCE_ID} --production --operator-token-file %d/operator.token --no-browser --port 8876 --index-interval-minutes ${SMART_LAB_INDEX_INTERVAL_MINUTES}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
UMask=0077
StateDirectory=smart-lab-index
StateDirectoryMode=0700

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/smart-lab-index
ReadOnlyPaths=/srv/lab-data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=4G
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
