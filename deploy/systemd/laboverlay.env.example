LABOVERLAY_SOURCE_ROOT=/srv/lab-data
LABOVERLAY_DATABASE=/var/lib/laboverlay/index.db
LABOVERLAY_SOURCE_ID=lab-production
LABOVERLAY_INDEX_INTERVAL_MINUTES=15
LABOVERLAY_NO_EGRESS=true
LABOVERLAY_PRODUCTION=true
LABOVERLAY_PARSER_TIMEOUT_SECONDS=60
LABOVERLAY_PARSER_CPU_SECONDS=45
LABOVERLAY_PARSER_MEMORY_MB=1024
LABOVERLAY_PARSER_OUTPUT_MB=128
