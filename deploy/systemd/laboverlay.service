[Unit]
Description=LabOverlay controlled-production service
After=local-fs.target
ConditionPathIsDirectory=/srv/lab-data
ConditionPathExists=/etc/laboverlay/operator.token

[Service]
Type=simple
User=laboverlay
Group=laboverlay
EnvironmentFile=/etc/laboverlay/laboverlay.env
WorkingDirectory=/var/lib/laboverlay
LoadCredential=operator.token:/etc/laboverlay/operator.token
ExecStart=/opt/laboverlay/venv/bin/laboverlay-app ${LABOVERLAY_SOURCE_ROOT} --database ${LABOVERLAY_DATABASE} --source-id ${LABOVERLAY_SOURCE_ID} --production --operator-token-file %d/operator.token --no-browser --port 8876 --index-interval-minutes ${LABOVERLAY_INDEX_INTERVAL_MINUTES}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=120s
UMask=0077
StateDirectory=laboverlay
StateDirectoryMode=0700

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
PrivateTmp=true
PrivateDevices=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/laboverlay
ReadOnlyPaths=/srv/lab-data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=4G
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
